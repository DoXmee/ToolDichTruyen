{
  "manifest_version": 3,
  "name": "Tool Dịch Truyện - Browser Helper",
  "version": "1.0.6",
  "description": "Đọc trang Huliwang và XSZJ/爱下电子书 bằng hồ sơ trình duyệt thường sau khi người dùng chủ động ghép nối với Tool Dịch Truyện.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://m.huliwang.net/*",
    "https://www.huliwang.net/*",
    "https://xszj.org/*",
    "https://www.xszj.org/*",
    "https://ixdzs8.com/*",
    "https://www.ixdzs8.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["pairing-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://m.huliwang.net/*", "https://www.huliwang.net/*"],
      "js": ["huli-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://xszj.org/*",
        "https://www.xszj.org/*",
        "https://ixdzs8.com/*",
        "https://www.ixdzs8.com/*"
      ],
      "js": ["xszj-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tool Dịch Truyện Browser Helper",
    "default_popup": "popup.html"
  }
}
